# Use a long, random value in production. Do not commit the real .env file.
SECRET_KEY=replace-with-a-long-random-secret

# Local development URL. Replace with the public HTTPS address in Heroku.
SITE_URL=http://127.0.0.1:5000

# Create a form at https://formspree.io and paste its endpoint here.
FORMSPREE_ENDPOINT=

# Optional public links.
GOOGLE_MAPS_URL=
LINKEDIN_URL=
